# Environment for deploy/nas/compose.collector-trial.yaml (the no-backup trial).
# Paste these into the stack's environment variables in Portainer. Nothing here
# is a credential; the trial has none.

# The trial image: the tag of the amd64 image you imported (Portainer, Images,
# Import), or a registry reference pinned by digest. No image is published yet.
COGVAULT_TRIAL_IMAGE=cogvault-trial:amd64

# Accepting the no-backup terms is an explicit act: this must be exactly the
# sentence below. If the NAS fails, the trial's originals and job history are lost.
COGVAULT_TRIAL_ACK=NO-BACKUP-TRIAL: I accept that every original and job record in this trial is lost if the NAS fails
# Who accepted it, and when (one line).
COGVAULT_TRIAL_ACCEPTED_BY=

# Exact host names that may be fetched, comma separated. The first smoke test uses
# the RFC Editor, whose usage notice allows free download and distribution:
# https://www.rfc-editor.org/series/rfc-use/
COGVAULT_TRIAL_ALLOWED_HOSTS=www.rfc-editor.org

# Limits (the defaults below are also the compose defaults; hard caps are in
# docs/deployment/trial.md and are enforced by the program).
# COGVAULT_TRIAL_MAX_QUEUED=10
# COGVAULT_TRIAL_MAX_SUBMITS_PER_DAY=20
# COGVAULT_TRIAL_MAX_FETCHES_PER_HOUR=20
# COGVAULT_TRIAL_MAX_FETCHES_PER_DAY=60
# COGVAULT_TRIAL_MIN_INTERVAL=10s
# COGVAULT_TRIAL_MAX_ATTEMPTS=3
