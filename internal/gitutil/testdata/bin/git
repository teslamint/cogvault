#!/bin/sh
# Fake `git` CLI for internal/gitutil timeout tests.
#
# It mimics the one behavior that makes SIGKILL dangerous: real `git add` and
# `git commit` hold .git/index.lock for the duration of the operation and
# remove it when they exit, including on SIGTERM. A killed-by-SIGKILL git
# leaves that lock behind forever.
#
# GIT_FAKE_LOCK_DIR  - directory to create index.lock in (a real .git dir)
# GIT_FAKE_ADD_SLEEP - seconds `add` works before succeeding
# GIT_FAKE_COMMIT_SLEEP - seconds `commit` works before succeeding

hold_lock_and_sleep() {
	seconds="$1"
	if [ -z "$GIT_FAKE_LOCK_DIR" ]; then
		sleep "$seconds"
		return 0
	fi

	lock="$GIT_FAKE_LOCK_DIR/index.lock"
	mkdir -p "$GIT_FAKE_LOCK_DIR"
	: >"$lock"
	# Same contract as real git: release the lock when asked to stop.
	trap 'rm -f "$lock"; exit 143' TERM
	trap 'rm -f "$lock"; exit 130' INT

	# Sleep in the background and wait, so the shell can service the trap
	# promptly instead of only after `sleep` returns.
	sleep "$seconds" &
	wait $!
	rm -f "$lock"
}

case "$*" in
*" add "*)
	if [ -n "$GIT_FAKE_ADD_SLEEP" ]; then
		hold_lock_and_sleep "$GIT_FAKE_ADD_SLEEP"
	fi
	exit 0
	;;
*" commit "*)
	if [ -n "$GIT_FAKE_COMMIT_SLEEP" ]; then
		hold_lock_and_sleep "$GIT_FAKE_COMMIT_SLEEP"
	fi
	exit 0
	;;
*)
	exit 0
	;;
esac
